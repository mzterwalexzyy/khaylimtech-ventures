rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products Collection:
    // Anyone (customers) can read the products catalog
    // Authenticated administrators can add, update, mark sold, and delete
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Settings Collection (Admin list, store configuration):
    // Anyone can read store settings; authenticated admins can update
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User accounts & profiles:
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
